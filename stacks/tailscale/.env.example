# Host-specific values. Copy to .env (gitignored) or enter as Portainer stack env vars
TS_AUTHKEY=                   # https://login.tailscale.com/admin/settings/keys (reusable); only needed for first start
TS_HOSTNAME=ugreen-nas
TS_ROUTES=192.168.1.0/24      # your LAN subnet; approve the route in the Tailscale admin console
TZ=America/Boise
APPDATA=/volume1/docker
TAILSCALE_TAG=latest
